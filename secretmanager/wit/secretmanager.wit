package gcloud:secretmanager@0.2.0;

interface types {
    use gcloud:auth/types@0.2.0.{error as auth-error};

    record secret-payload {
        data: list<u8>,
    }

    record secret {
        name: string,
        create-time: option<string>,
    }

    record secret-version {
        name: string,
        state: secret-version-state,
        create-time: option<string>,
        destroy-time: option<string>,
    }

    enum secret-version-state {
        state-unspecified,
        enabled,
        disabled,
        destroyed,
    }

    /// Replication policy for create-secret. Only automatic is supported.
    enum replication {
        automatic,
    }

    variant error {
        auth(auth-error),
        request-failed(string),
    }
}

interface secrets {
    use types.{secret-payload, secret, secret-version, replication, error};

    /// Access a secret version's payload.
    /// `name` is the resource name: `projects/{project}/secrets/{secret}/versions/{version}`
    /// Use "latest" as version to access the most recent version.
    access: func(name: string) -> result<secret-payload, error>;

    /// List secrets in a project.
    /// `parent` is "projects/{project}"
    list-secrets: func(parent: string) -> result<list<secret>, error>;

    /// Get a secret's metadata.
    /// `name` is "projects/{project}/secrets/{secret}"
    get-secret: func(name: string) -> result<secret, error>;

    /// List versions of a secret.
    /// `parent` is "projects/{project}/secrets/{secret}"
    list-secret-versions: func(parent: string) -> result<list<secret-version>, error>;

    /// Add a new version with payload data.
    /// `parent` is "projects/{project}/secrets/{secret}"
    add-secret-version: func(parent: string, payload: secret-payload) -> result<secret-version, error>;

    /// Create a new secret.
    /// `parent` is "projects/{project}", `secret-id` is the secret name
    create-secret: func(parent: string, secret-id: string, replication: replication) -> result<secret, error>;

    /// Delete a secret.
    /// `name` is "projects/{project}/secrets/{secret}"
    delete-secret: func(name: string) -> result<_, error>;
}

world secretmanager-provider {
    import gcloud:auth/token-source@0.2.0;
    export secrets;
}
