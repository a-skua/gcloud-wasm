package gcloud:secretmanager@0.1.0;

interface types {
    use gcloud:auth/types@0.1.0.{error as auth-error};

    record secret-payload {
        data: list<u8>,
    }

    variant error {
        auth(auth-error),
        request-failed(string),
    }
}

interface secrets {
    use types.{secret-payload, error};

    /// Access a secret version's payload.
    /// `name` is the resource name: `projects/{project}/secrets/{secret}/versions/{version}`
    /// Use "latest" as version to access the most recent version.
    access: func(name: string) -> result<secret-payload, error>;
}

world secretmanager-provider {
    import gcloud:auth/token-source@0.1.0;
    export secrets;
}
