package example:composition;

let auth = new gcloud:auth { ... };
let storage = new gcloud:storage {
    "gcloud:auth/token-source@0.1.0": auth["gcloud:auth/token-source@0.1.0"],
    ...
};
let app = new example:storage {
    "gcloud:storage/buckets@0.1.0": storage["gcloud:storage/buckets@0.1.0"],
    ...
};

export app...;
