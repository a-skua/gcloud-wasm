package example:composition;

let auth = new gcloud:auth { ... };
let secretmanager = new gcloud:secretmanager {
    "gcloud:auth/token-source@0.1.0": auth["gcloud:auth/token-source@0.1.0"],
    ...
};
let app = new example:secretmanager {
    "gcloud:secretmanager/secrets@0.1.0": secretmanager["gcloud:secretmanager/secrets@0.1.0"],
    ...
};

export app...;
